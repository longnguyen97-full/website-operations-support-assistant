# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG
# ==========================================

# Múi giờ
TIMEZONE_OFFSET_HOURS=7
TIMEZONE_NAME=Asia/Ho_Chi_Minh

# Cơ sở dữ liệu
DATA_DIR=data
DB_FILE_NAME=monitoring.db
DATA_RETENTION_DAYS=30

# Bộ lập lịch (mặc định 4 tiếng = 14400 giây)
SCHEDULER_INTERVAL_SECONDS=14400

# Cấu hình Email & SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_digit_app_password
RECIPIENT_EMAILS=devops@example.com,admin@example.com
EMAIL_ENABLED=true
NOTIFY_CRITICAL=true
NOTIFY_WARNING=true
NOTIFY_RECOVERY=true
COOLDOWN_MINUTES=15

# Báo cáo Sức khỏe Định kỳ Hàng ngày
ENABLE_DAILY_REPORT=false
DAILY_REPORT_TIME=08:00

# Tham số mạng
HTTP_TIMEOUT_SECONDS=10.0
DNS_TIMEOUT_SECONDS=5.0
SSL_TIMEOUT_SECONDS=10.0
SSL_EXPIRY_WARNING_DAYS=14

# ==========================================
# CẤU HÌNH AI & MÔ HÌNH NGÔN NGỮ LỚN (GEMINI LLM)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_ENABLED=false
